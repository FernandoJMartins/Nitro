# Variáveis usadas pelo docker-compose. Copie para ".env" (na raiz) e ajuste.

# Senha do banco Postgres que o compose vai criar.
POSTGRES_PASSWORD=troque_esta_senha

# Chave da OpenAI — só necessária para os recursos de IA (frases/legenda). Opcional.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Segredo para assinar os tokens de login (JWT). TROQUE em produção!
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-troque-em-producao

# ---------------------------------------------------------------------------
# Só para o docker-compose.local-db.yml (usa o SEU Postgres local, não container)
# URL do seu Postgres. Troque a senha; deixe host.docker.internal (= sua máquina).
# ---------------------------------------------------------------------------
LOCAL_DATABASE_URL=postgresql+psycopg://postgres:SUA_SENHA@host.docker.internal:5432/videos_em_massa

# ---------------------------------------------------------------------------
# Nitro SaaS (docker-compose.saas.yml) — planos, admins e Stripe
# ---------------------------------------------------------------------------
# Banco PRÓPRIO do SaaS (nunca o mesmo do Nitro caseiro)
SAAS_DATABASE_URL=postgresql+psycopg://postgres:SUA_SENHA@host.docker.internal:5432/nitro_saas
SAAS_SECRET_KEY=troque-por-um-segredo-longo
# e-mails com controle total (sem pagamento, sem limites, painel Admin)
ADMIN_EMAILS=scarlett.campelo@gmail.com,julio8martins@gmail.com
# URL pública do frontend (retorno do Checkout da Stripe e CORS)
APP_URL=http://localhost:5273
# Stripe: chaves em https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# price_id MENSAL recorrente de cada plano (Produtos > Preços na Stripe)
STRIPE_PRICE_BASICO=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCIA=
# vídeos gerados são apagados após N dias (vale para todos, inclusive admins)
VIDEO_RETENTION_DAYS=3

# --- Vigilância (Admin → Sistema) ---
# Nome deste servidor nos avisos (Casa / nitroflow.site)
INSTANCE_NAME=
# Avisos no Telegram: crie um bot no @BotFather e veja o README para achar o chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Proxy RESIDENCIAL para o teste diário de login em servidor com IP de data center (droplet).
# Ex.: socks5h://usuario:senha@host:porta  (vazio = usa um proxy residencial já cadastrado)
INSTAGRAM_CANARY_PROXY=
