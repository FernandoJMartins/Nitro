# Copie este arquivo para .env e ajuste os valores.

# Conexão com o PostgreSQL local.
# Formato: postgresql+psycopg://USUARIO:SENHA@HOST:PORTA/BANCO
# Troque SUA_SENHA pela senha que você definiu ao instalar o Postgres.
DATABASE_URL=postgresql+psycopg://postgres:SUA_SENHA@localhost:5432/videos_em_massa

# Pasta onde os arquivos de mídia ficam salvos em disco (fora do banco).
STORAGE_DIR=./storage

# Origens permitidas no CORS (o frontend). Separe por vírgula.
CORS_ORIGINS=http://localhost:5173

# Chave da OpenAI (só usada no recurso de IA — Fase 3). Deixe vazio por enquanto.
OPENAI_API_KEY=

# Segredo para assinar os tokens de login (JWT). TROQUE por um valor aleatório
# em produção. Ex.: gere com  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-troque-em-producao
